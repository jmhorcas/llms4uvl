features
	eShop
		mandatory
			Catalogue
			Security
				alternative
					Standard {price 50}
					High {price 100}
		optional
			SEO
			Payment
				alternative
					BankTransfer {price 10, SEPA true}
					CreditCard {price 20}
			Platform
				or
					MobileApp
					Browser {URL "www.uvleshop.org"}
					DesktopApp

constraints
	Platform => sum(Platform.MobileApp, Platform.Browser, Platform.DesktopApp) >= 2
	Platform => sum(Platform.MobileApp, Platform.Browser, Platform.DesktopApp) <= 3
	CreditCard => High
	!BankTransfer | !MobileApp
	sum(Standard.price, High.price, BankTransfer.price, CreditCard.price) < 200