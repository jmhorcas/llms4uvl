```uvl
features
	eShop
		mandatory
			Catalogue
				cardinality [1..5]
					{price 30}
			Security
				alternative
					Standard
						{price 50}
					High
						{price 100}
		optional
			SEO
				{price 40}
			Payment
				alternative
					"Bank Transfer"
						{price 10, SEPA true}
					"Credit Card"
						{price 20}
			Platform
				or
					"Mobile App"
						{price 80}
					Browser String
						{price 20}
					"Desktop App"
						{price 70}

constraints
	Platform => "Mobile App" | Browser | "Desktop App"
	"Credit Card" => High
	!"Bank Transfer" | !"Mobile App"
	sum(price) < 200
	"Items in Basket" > 0
	len(Browser) <= 30
```

