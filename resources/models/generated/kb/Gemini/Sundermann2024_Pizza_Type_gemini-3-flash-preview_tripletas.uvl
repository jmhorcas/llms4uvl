features
	Pizza
		mandatory
			Base {price 2.0}
			Sauce
				alternative
					Tomato {price 0.8}
					Creme_Fraiche {price 1.1}
			DeliveryAddresses [1..10]
				mandatory
					Street {type "string"}
					City {type "string"}
			Size {type "integer"}
		optional
			Cheese
				or
					Mozzarella {price 0.4}
					Cheddar {price 0.6}
			Toppings [1..3]
				or
					Mushrooms {price 0.5}
					Onion {price 0.3}
					Olive {price 0.3}
					Pineapple {price 0.8}

constraints
	Cheddar => !Creme_Fraiche
	sum(price) < 5
	Size >= 20
	Size <= 60
	City == "Omashu"
	len(Street) <= 100