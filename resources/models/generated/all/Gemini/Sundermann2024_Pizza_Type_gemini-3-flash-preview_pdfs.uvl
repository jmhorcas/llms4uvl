include
	Boolean.group-cardinality
	Arithmetic.feature-cardinality
	Arithmetic.aggregate-function
	Type.string-constraints

features
	Pizza
		mandatory
			Base {Price 2.0}
			Integer Size
		mandatory
			Sauce
				alternative
					Tomato {Price 0.8}
					"Creme Fraiche" {Price 1.1}
		optional
			Cheese
				or
					Mozzarella {Price 0.4}
					Cheddar {Price 0.6}
		optional
			Toppings
				[1..3]
					Mushrooms {Price 0.5}
					Onion {Price 0.3}
					Olive {Price 0.3}
					Pineapple {Price 0.8}
		optional
			DeliveryAddress cardinality [1..10]
				mandatory
					String Street
					String City

constraints
	Cheddar => !"Creme Fraiche"
	sum(Price) < 5
	Size >= 20
	Size <= 60
	City == 'Omashu'
	len(Street) <= 100