include
	Arithmetic.feature-cardinality
	Type

features
	MultifunctionalSystem
		mandatory
			Printer
				alternative PrinterType
					BWPrinter
					ColorPrinter
					PhotoPrinter
				optional
					GreenMode
				mandatory
					Integer PrinterResolution
				mandatory
					Cartridge cardinality [1..4]
						mandatory
							Integer InkVolume
		mandatory
			Scanner
				alternative ScannerType
					BWScanner
					ColorScanner
				mandatory
					Integer ScannerResolution

constraints
	GreenMode => !PhotoPrinter