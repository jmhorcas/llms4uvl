features
	EdgeSystem
		mandatory
			NetworkInterfaces
				or
					Mobile
						alternative
							"3G" {Cost 30}
							"4G" {Cost 40}
							"5G" {Cost 75}
					WiFi
					Ethernet {Cost 15}
			VNFs
				or
					Monitor
					Firewall
					Encryption
		optional
			Antennas
				or
					Small {Cost 3}
					Normal {Cost 4}
					Large {Cost 5}

constraints
	Ethernet => !Antennas