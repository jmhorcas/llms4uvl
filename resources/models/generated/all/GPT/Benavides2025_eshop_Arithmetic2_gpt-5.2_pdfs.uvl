include
	Arithmetic.aggregate-function
	Type.feature-cardinality
	Type
	Boolean

features
	eShop
		mandatory
			Catalogue feature-cardinality [1..5] {price 30}
			Security
				alternative
					Standard {price 50}
					High {price 100}
		optional
			SEO
			Payment
				alternative
					"Bank Transfer" {price 10, SEPA true}
					"Credit Card" {price 20}
			Platform
				[2..3]
					"Mobile App"
					Browser {URL 'www.uvleshop.org'}
					"Desktop App"

constraints
	sum(price) < 200
	"Credit Card" => High
	!("Bank Transfer" & "Mobile App")