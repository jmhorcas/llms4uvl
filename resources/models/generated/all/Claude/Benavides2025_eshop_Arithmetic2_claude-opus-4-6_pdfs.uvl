include
	Boolean.group-cardinality
	Arithmetic.aggregate-function
	Arithmetic.feature-cardinality

features
	eShop
		mandatory
			Security
				alternative
					High {Price 100}
					Standard {Price 50}
			Catalogue cardinality [1..5] {Price 30}
		optional
			SEO
			Payment
				alternative
					"Bank Transfer" {Price 10, SEPA true}
					"Credit Card" {Price 20}
			Platform
				[2..3]
					"Mobile App"
					Browser {URL 'www.uvleshop.org'}
					"Desktop App"

constraints
	!("Bank Transfer" & "Mobile App")
	"Credit Card" => High
	sum(Price) < 200